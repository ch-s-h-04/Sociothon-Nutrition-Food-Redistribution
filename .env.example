# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# Optional External Services (Application includes deterministic offline fallbacks)
# Nominatim Geocoding (Free / OpenStreetMap, no key required)
GEOCODING_USER_AGENT=Sociothon-Nutrition-FoodRecovery/1.0

# Optional Mapbox token for high-res map tiles (Fallback: OpenStreetMap tiles)
VITE_MAPBOX_TOKEN=

# Optional AI Analysis (Azure OpenAI / Grok fallback)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
